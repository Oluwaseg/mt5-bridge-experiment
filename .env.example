PORT=8000
MT5_TERMINAL_PATH=
# Leave the terminal credentials empty to use the account already logged into the local MT5 terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Required for the authenticated remote worker that connects to the Node backend.
# The backend must expose the same secret on its MT5 bridge config.
MT5_AGENT_SECRET=
MT5_BRIDGE_URL=http://127.0.0.1:8000

# Optional: enable the actual remote worker identity flow from the Node backend.
REMOTE_WORKER_ENABLED=true
WORKER_IDENTITY_SERVER_URL=ws://127.0.0.1:4000/api/worker-connect
WORKER_ID=windows-demo-worker
WORKER_IDENTITY_TOKEN=
WORKER_RECONNECT_DELAY_SECONDS=2

# Optional development testing only; leave unset for real demo use.
# WORKER_TEST_DISCONNECT_ONCE=false
